<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-16.16logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <logger name="org.snmp4j" level="ERROR" />
    <logger name="RFC3414" level="ERROR" />
    <logger name="SnmpDispatcherPool" level="ERROR" />
</configuration>